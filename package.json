{
  "publisher": "simonhe",
  "name": "vscode-fake-coding",
  "displayName": "Fake Coding for VS Code",
  "version": "0.2.3",
  "description": "Simulate realistic coding in VS Code with fake typing, cursor or selection playback, active file switching, and auto wander across open tabs.",
  "author": "Simon He <https://github.com/Simon-He95>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Simon-He95",
  "homepage": "https://github.com/Simon-He95/vscode-fake-coding#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simon-He95/vscode-fake-coding"
  },
  "bugs": {
    "url": "https://github.com/Simon-He95/vscode-fake-coding/issues"
  },
  "sponsor": {
    "url": "https://github.com/Simon-He95/sponsor"
  },
  "keywords": [
    "vscode",
    "vs-code",
    "visual-studio-code",
    "vscode-extension",
    "coding-simulator",
    "coding-simulation",
    "fake-coding",
    "fake-typing",
    "typing-simulator",
    "realistic-typing",
    "editor-activity",
    "cursor",
    "selection",
    "open-tabs",
    "demo",
    "developer-tools",
    "productivity"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fake-coding.start",
        "title": "Fake Coding: Start"
      },
      {
        "command": "fake-coding.startFromCursor",
        "title": "Fake Coding: Start From Cursor"
      },
      {
        "command": "fake-coding.startFromSelection",
        "title": "Fake Coding: Start From Selection"
      },
      {
        "command": "fake-coding.startInteractive",
        "title": "Fake Coding: Start Interactive"
      },
      {
        "command": "fake-coding.startWander",
        "title": "Fake Coding: Start Wander"
      },
      {
        "command": "fake-coding.pause",
        "title": "Fake Coding: Pause"
      },
      {
        "command": "fake-coding.resume",
        "title": "Fake Coding: Resume"
      },
      {
        "command": "fake-coding.stop",
        "title": "Fake Coding: Stop"
      },
      {
        "command": "fake-coding.toggle",
        "title": "Fake Coding: Toggle"
      },
      {
        "command": "fake-coding.usePreset.steady",
        "title": "Fake Coding: Use Preset - Steady"
      },
      {
        "command": "fake-coding.usePreset.realistic",
        "title": "Fake Coding: Use Preset - Realistic"
      },
      {
        "command": "fake-coding.usePreset.fastDemo",
        "title": "Fake Coding: Use Preset - Fast Demo"
      },
      {
        "command": "fake-coding.usePreset.slowReview",
        "title": "Fake Coding: Use Preset - Slow Review"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "fake-coding",
      "properties": {
        "fake-coding.interval": {
          "type": "number",
          "default": 200,
          "description": "Control the typing speed in milliseconds."
        },
        "fake-coding.mode": {
          "type": "string",
          "enum": [
            "steady",
            "realistic"
          ],
          "default": "steady",
          "description": "Typing rhythm mode."
        },
        "fake-coding.startFrom": {
          "type": "string",
          "enum": [
            "fileStart",
            "cursor",
            "selection"
          ],
          "default": "fileStart",
          "description": "Where fake coding starts from."
        },
        "fake-coding.autoStopMinutes": {
          "type": "number",
          "enum": [
            0,
            5,
            15,
            30
          ],
          "default": 0,
          "description": "Automatically stop after the specified minutes. 0 disables it."
        },
        "fake-coding.saveOnStop": {
          "type": "boolean",
          "default": true,
          "description": "Save the file after restoring original content when stopped."
        },
        "fake-coding.activityMinChars": {
          "type": "number",
          "default": 40,
          "description": "Minimum fake activity window size for follow and wander modes, measured in characters."
        },
        "fake-coding.activityMaxChars": {
          "type": "number",
          "default": 80,
          "description": "Maximum fake activity window size for follow and wander modes, measured in characters."
        },
        "fake-coding.wanderMinSeconds": {
          "type": "number",
          "enum": [
            5,
            9,
            15,
            30
          ],
          "default": 9,
          "description": "Minimum seconds to stay in a file before auto wander switches again."
        },
        "fake-coding.wanderMaxSeconds": {
          "type": "number",
          "enum": [
            9,
            18,
            30,
            45
          ],
          "default": 18,
          "description": "Maximum seconds to stay in a file before auto wander switches again."
        },
        "fake-coding.wanderSkipDirtyFiles": {
          "type": "boolean",
          "default": true,
          "description": "Skip already-dirty files when auto wander looks for the next target."
        },
        "fake-coding.wanderAllowLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Only wander into these VS Code language IDs. Leave empty to allow all languages."
        },
        "fake-coding.wanderMaxFileChars": {
          "type": "number",
          "default": 0,
          "description": "Skip files larger than this many characters during auto wander. 0 disables the limit."
        },
        "fake-coding.wanderIgnorePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Skip files whose paths contain any of these substrings during auto wander."
        }
      }
    }
  },
  "scripts": {
    "dev": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "build:minify": "tsup --minify",
    "pack": "npm run build && vsce package --no-dependencies",
    "lint": "eslint . --cache",
    "lint:fix": "npm run lint --fix",
    "publish": "npm run build && vsce publish --no-dependencies",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release": "npm run build:minify && bumpp && npm run publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.12.1",
    "@types/node": "^18.19.68",
    "@types/vscode": "^1.96.0",
    "@vscode-use/utils": "0.1.32",
    "@vscode/vsce": "^3.2.1",
    "bumpp": "^9.9.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
