{
  "publisher": "simonhe",
  "name": "vscode-fake-coding",
  "displayName": "VSCode Fake Coding",
  "version": "0.2.0",
  "description": "A VSCode extension for simulating coding activity with customizable typing speed.",
  "author": "Simon He <https://github.com/Simon-He95>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/Simon-He95",
  "homepage": "https://github.com/Simon-He95/vscode-fake-coding#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simon-He95/vscode-fake-coding"
  },
  "bugs": {
    "url": "https://github.com/Simon-He95/vscode-fake-coding/issues"
  },
  "sponsor": {
    "url": "https://github.com/Simon-He95/sponsor"
  },
  "keywords": [
    "vscode",
    "vscode-extension",
    "coding-simulation",
    "fake-coding",
    "developer-tools",
    "productivity"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fake-coding.start",
        "title": "Fake Coding: Start"
      },
      {
        "command": "fake-coding.startFromCursor",
        "title": "Fake Coding: Start From Cursor"
      },
      {
        "command": "fake-coding.startFromSelection",
        "title": "Fake Coding: Start From Selection"
      },
      {
        "command": "fake-coding.pause",
        "title": "Fake Coding: Pause"
      },
      {
        "command": "fake-coding.resume",
        "title": "Fake Coding: Resume"
      },
      {
        "command": "fake-coding.stop",
        "title": "Fake Coding: Stop"
      },
      {
        "command": "fake-coding.toggle",
        "title": "Fake Coding: Toggle"
      },
      {
        "command": "fake-coding.usePreset.steady",
        "title": "Fake Coding: Use Preset - Steady"
      },
      {
        "command": "fake-coding.usePreset.realistic",
        "title": "Fake Coding: Use Preset - Realistic"
      },
      {
        "command": "fake-coding.usePreset.fastDemo",
        "title": "Fake Coding: Use Preset - Fast Demo"
      },
      {
        "command": "fake-coding.usePreset.slowReview",
        "title": "Fake Coding: Use Preset - Slow Review"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "fake-coding",
      "properties": {
        "fake-coding.interval": {
          "type": "number",
          "default": 200,
          "description": "Control the typing speed in milliseconds."
        },
        "fake-coding.mode": {
          "type": "string",
          "enum": [
            "steady",
            "realistic"
          ],
          "default": "steady",
          "description": "Typing rhythm mode."
        },
        "fake-coding.startFrom": {
          "type": "string",
          "enum": [
            "fileStart",
            "cursor",
            "selection"
          ],
          "default": "fileStart",
          "description": "Where fake coding starts from."
        },
        "fake-coding.autoStopMinutes": {
          "type": "number",
          "enum": [
            0,
            5,
            15,
            30
          ],
          "default": 0,
          "description": "Automatically stop after the specified minutes. 0 disables it."
        },
        "fake-coding.saveOnStop": {
          "type": "boolean",
          "default": true,
          "description": "Save the file after restoring original content when stopped."
        }
      }
    }
  },
  "scripts": {
    "dev": "nr build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "pack": "npm run build && vsce package --no-dependencies",
    "lint": "eslint . --cache",
    "lint:fix": "nr lint --fix",
    "publish": "npm run build && vsce publish --no-dependencies",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release": "nr build --minify && bumpp && nr publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.12.1",
    "@types/node": "^18.19.68",
    "@types/vscode": "^1.96.0",
    "@vscode-use/utils": "0.1.32",
    "@vscode/vsce": "^3.2.1",
    "bumpp": "^9.9.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
